rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ashuk2968@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.uid == resource.data.userId);
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.mobile is string && data.mobile.size() <= 15 &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['user', 'admin', 'compliance_officer', 'finance_admin'] &&
             data.status in ['active', 'suspended', 'blocked'] &&
             data.kycStatus in ['not_submitted', 'pending', 'verified', 'rejected'];
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() <= 64 &&
             data.availableBalance is number && data.availableBalance >= 0 &&
             data.pendingBalance is number && data.pendingBalance >= 0 &&
             data.totalHelpedGiven is number && data.totalHelpedGiven >= 0 &&
             data.totalHelpedReceived is number && data.totalHelpedReceived >= 0 &&
             data.totalReferralRewards is number && data.totalReferralRewards >= 0 &&
             data.totalWithdrawn is number && data.totalWithdrawn >= 0;
    }

    function isValidHelpRequest(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000 &&
             data.type in ['give_help', 'receive_help'] &&
             data.status is string && data.status.size() <= 30;
    }

    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.type is string && data.type.size() <= 40 &&
             data.amount is number && data.amount > 0 &&
             data.balanceAfter is number &&
             data.status in ['pending', 'completed', 'failed', 'rejected'];
    }

    function isValidKyc(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.fullNameAsPerId is string && data.fullNameAsPerId.size() <= 100 &&
             data.status in ['not_submitted', 'pending', 'verified', 'rejected'];
    }

    function isValidWithdrawal(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.netPayable is number && data.netPayable >= 0 &&
             data.payoutMethod in ['upi', 'bank_transfer'] &&
             data.status is string && data.status.size() <= 30;
    }

    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.subject is string && data.subject.size() <= 150 &&
             data.category is string && data.category.size() <= 50 &&
             data.priority in ['low', 'medium', 'high'] &&
             data.status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 64 &&
             data.title is string && data.title.size() <= 120 &&
             data.message is string && data.message.size() <= 300 &&
             data.type in ['info', 'success', 'warning', 'alert'] &&
             data.isRead is bool;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.actorId is string && data.actorId.size() <= 64 &&
             data.actorName is string && data.actorName.size() <= 100 &&
             data.action is string && data.action.size() <= 80;
    }

    function isValidSettings(data) {
      return data.helpAmountDefault is number && data.helpAmountDefault > 0 &&
             data.minWithdrawalAmount is number && data.minWithdrawalAmount > 0 &&
             data.timerDurationHours is number && data.timerDurationHours > 0;
    }

    // 2. Collection Rules

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || resource.data.id == userId);
      allow list: if isSignedIn() && (isAdmin() || resource.data.id != null);
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          (request.auth.uid == userId || incoming().id == userId) &&
          incoming().role == 'user'
        )
      );
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || (
          (request.auth.uid == userId || existing().id == userId) &&
          incoming().role == existing().role &&
          incoming().id == existing().id &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'mobile', 'email', 'sponsorId', 'status', 'kycStatus',
            'isMobileVerified', 'isEmailVerified', 'lastLoginAt', 'avatarUrl', 'paymentDetails'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Wallets Collection
    match /wallets/{walletId} {
      allow get: if isSignedIn() && (request.auth.uid == walletId || isAdmin() || resource.data.userId == walletId);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(walletId) && isValidWallet(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidWallet(incoming()) && (
        isAdmin() || (
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'availableBalance', 'pendingBalance', 'totalHelpedGiven',
            'totalHelpedReceived', 'totalReferralRewards', 'totalWithdrawn', 'lastUpdated'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Help Requests Collection
    match /helpRequests/{helpRequestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.matchedWithUserId == request.auth.uid ||
        resource.data.status == 'waiting_for_help' ||
        resource.data.status == 'pending'
      );
      allow create: if isSignedIn() && isValidId(helpRequestId) && isValidHelpRequest(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidHelpRequest(incoming()) && (
        isAdmin() || (
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().amount == existing().amount &&
          incoming().type == existing().type &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'matchedWithUserId', 'matchedWithUserName', 'matchedWithUpi',
            'matchedWithMobile', 'proofReference', 'paymentSlipUrl', 'adminApproved',
            'timerStartTime', 'timerExpiryTime', 'timerStatus'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Transactions Collection (Append-only ledger)
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if false; // Immutable ledger record
      allow delete: if isAdmin();
    }

    // KYC Records Collection (PII isolation)
    match /kycRecords/{kycRecordId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(kycRecordId) && isValidKyc(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidKyc(incoming()) && (
        isAdmin() || (
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullNameAsPerId', 'aadhaarNumber', 'panNumber', 'documentType',
            'upiId', 'bankName', 'accountNumber', 'ifscCode', 'status', 'submittedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Withdrawals Collection
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawal(incoming()) && (
        isAdmin() || (incoming().userId == request.auth.uid && incoming().status == 'pending')
      );
      allow update: if isSignedIn() && isValidWithdrawal(incoming()) && (
        isAdmin() || (
          incoming().userId == existing().userId &&
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'payoutUpiId'])
        )
      );
      allow delete: if isAdmin();
    }

    // Support Tickets Collection
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidSupportTicket(incoming()) && (
        isAdmin() || (
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidNotification(incoming()) && (
        isAdmin() || (
          (resource.data.userId == request.auth.uid || resource.data.userId == 'all') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        )
      );
      allow delete: if isAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{auditLogId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(auditLogId) && isValidAuditLog(incoming());
      allow update: if false; // Append-only
      allow delete: if false; // Permanent audit trail
    }

    // Settings Collection (Global platform configuration)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // Test Collection (for testConnection on boot)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
